# Apptainer (antes Singularity), para clústeres compartidos sin Docker (decisión D-4).
#   apptainer build syllabusai.sif docker/syllabusai.def          (desde la carpeta Practica)
#   apptainer run --bind $PWD/data:/app/data syllabusai.sif api
#   apptainer run --bind $PWD/data:/app/data syllabusai.sif ui
# vLLM se ejecuta en otro contenedor o en un entorno virtual con acceso a la GPU (--nv).
Bootstrap: docker
From: python:3.12-slim

%files
    pyproject.toml /app/pyproject.toml
    requirements.lock /app/requirements.lock
    README.md /app/README.md
    syllabusai /app/syllabusai
    config /app/config
    ejemplos /app/ejemplos
    eval /app/eval
    ModeloEducativo.pdf /app/ModeloEducativo.pdf
    Propuesta_nuevo_silabo_y_guia_UTI_2026.docx /app/Propuesta_nuevo_silabo_y_guia_UTI_2026.docx
    Guia_Construccion_PIS.docx /app/Guia_Construccion_PIS.docx
    docker/entrypoint.sh /usr/local/bin/entrypoint.sh

%post
    apt-get update && apt-get install -y --no-install-recommends libreoffice-writer-nogui fonts-dejavu
    rm -rf /var/lib/apt/lists/*
    cd /app && pip install --no-cache-dir -r requirements.lock && pip install --no-cache-dir ".[embeddings]"
    chmod +x /usr/local/bin/entrypoint.sh
    mkdir -p /app/data

%environment
    export PYTHONUNBUFFERED=1
    export SYLLABUSAI_CONFIG=/app/config/config.a100.yaml

%runscript
    cd /app && exec /usr/local/bin/entrypoint.sh "$@"
